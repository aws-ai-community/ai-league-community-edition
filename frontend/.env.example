# Local development environment variables
# These are only needed when running the frontend locally without a deployed backend.
# In production, the app reads configuration from /aws-exports.json deployed by CDK.

# Cognito User Pool ID (from CDK stack outputs after first deploy)
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito App Client ID (from CDK stack outputs after first deploy)
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API endpoint URL (from CDK stack outputs - the CloudFront domain + /api/v1)
VITE_API_URL=https://dxxxxxxxxxxxxx.cloudfront.net/api/v1
